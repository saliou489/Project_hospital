# Copiez ce fichier en « .env » puis renseignez les valeurs. Le fichier .env n'est jamais publié (voir .gitignore).

# Mot de passe de la base PostgreSQL (obligatoire). Choisissez une valeur longue et aléatoire.
POSTGRES_PASSWORD=

# Secret de signature des sessions (obligatoire). Exemple pour en générer un :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDIRDV_SECRET_JWT=

# Nom affiché dans l'interface.
NOM_CLINIQUE=BAOBAB

# Premier démarrage : « oui » génère les données de démonstration (12 mois d'historique, 3 mois à venir).
MEDIRDV_DONNEES_DEMO=oui

# Sécurité des comptes (valeurs par défaut).
MEDIRDV_MAX_ESSAIS=5
MEDIRDV_VERROUILLAGE_MIN=5
MEDIRDV_SESSION_HEURES=8

# Score de risque d'absence : hypothèses du calcul coût / bénéfice (à faire valider par la clinique) et heure du calcul nocturne.
MEDIRDV_COUT_RELANCE=1000
MEDIRDV_COUT_CRENEAU=15000
MEDIRDV_EFFICACITE_RELANCE=0.35
MEDIRDV_HEURE_NOCTURNE=02:00

# HTTPS (optionnel) : docker compose --profile https up -d. Laissez « localhost » pour un essai (https://localhost:8443),
# ou indiquez votre nom de domaine pour un certificat public automatique.
MEDIRDV_DOMAINE=localhost

# Sauvegarde et conservation des données : valeurs par défaut (propositions à valider par la clinique, voir docs/sauvegarde_et_conservation.md).
MEDIRDV_HEURE_SAUVEGARDE=03:00
MEDIRDV_NB_SAUVEGARDES=14
MEDIRDV_CONSERVATION_PATIENT_ANS=5
MEDIRDV_CONSERVATION_JOURNAL_MOIS=24
MEDIRDV_CONSERVATION_POINTAGE_MOIS=24
MEDIRDV_CONSERVATION_EVALUATIONS_MOIS=12
